# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# compinit
autoload -Uz compinit && compinit

# zinit
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if [ ! -d "${ZINIT_HOME}" ]; then
    mkdir -p "$(dirname $ZINIT_HOME)"
    git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi
source "${ZINIT_HOME}/zinit.zsh"

# zsh plugins
zinit ice depth"1"
zinit light romkatv/powerlevel10k
zinit light zdharma-continuum/fast-syntax-highlighting

# custom scripts from https://github.com/changs/slimzsh/
setopt autocd
setopt extendedglob
setopt NO_NOMATCH
source ${HOME}/.config/zsh/keys.zsh
source ${HOME}/.config/zsh/history.zsh
source ${HOME}/.config/zsh/completion.zsh
source ${HOME}/.config/zsh/correction.zsh
source ${HOME}/.config/zsh/stack.zsh

# move cursor by word
bindkey '^[[1;3C' forward-word
bindkey '^[[1;3D' backward-word

# locale
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Editor configuration
export EDITOR=nvim
alias vi=nvim
alias vim=nvim

# PATH
export PATH="$HOME/.local/bin:$HOME/.pi/agent/bin:$HOME/.cargo/bin:$PATH"

# ls command
export CLICOLOR=1 # for Darwin
ls --color=auto &> /dev/null && alias ls='ls --color=auto'
alias ll='ls -lh'

cb() {
  [ -t 0 ] && { echo "usage: cmd | cb" >&2; return 1; }
  local data
  data=$(base64 | tr -d '\r\n')
  printf "\e]52;c;%s\a" "$data" > /dev/tty
}

# fzf
FZF_ROOT=/usr/share/fzf
if [[ -f "${FZF_ROOT}/key-bindings.zsh" ]]; then
  # maybe archlinux?
  source "${FZF_ROOT}/key-bindings.zsh"
  source "${FZF_ROOT}/completion.zsh"
elif [[ -f "${HOME}/.fzf.zsh" ]]; then
  # other distributions
  source "${HOME}/.fzf.zsh"
fi

# go
export GOPATH="$HOME/.go"
if [ -d "$GOPATH/bin" ]; then
    export PATH="$GOPATH/bin:$PATH"
fi
if [ -d "/usr/local/go/bin" ]; then
    export PATH="/usr/local/go/bin:$PATH"
elif [ -d "/opt/homebrew/opt/go/bin" ]; then
    export PATH="/opt/homebrew/opt/go/bin:$PATH"
fi

# import local zsh confiuration
if [[ -f "$HOME/.config/zsh/zshrc.local" ]]; then
    source "$HOME/.config/zsh/zshrc.local"
fi

# SSH agent socket override
SOCK_SYMLINK="$HOME/.ssh/ssh_auth_sock"
if [ -z "$TMUX" ] && [ -n "$SSH_AUTH_SOCK" ] && [ -S "$SSH_AUTH_SOCK" ]; then
    ln -sf "$SSH_AUTH_SOCK" "$SOCK_SYMLINK"
fi
if [ -n "$TMUX" ]; then
    export SSH_AUTH_SOCK="$SOCK_SYMLINK"
fi

# kubectl autocompletion
if [ -x "$(command -v kubectl)" ]; then
    source <(kubectl completion zsh)
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
