#!/usr/bin/env python3
import ctypes
import fcntl
import os
import sys

I2C_RDWR = 0x0707
I2C_ADDR = 0x37
I2C_BUS = "/dev/i2c-13"
INPUTS = {"hdmi1": 0x90, "hdmi2": 0x91, "dp": 0xD0, "usbc": 0xD1}

class I2CMsg(ctypes.Structure):
    _fields_ = [("addr", ctypes.c_uint16), ("flags", ctypes.c_uint16), ("len", ctypes.c_uint16), ("buf", ctypes.c_void_p)]

class I2CRdwr(ctypes.Structure):
    _fields_ = [("msgs", ctypes.POINTER(I2CMsg)), ("nmsgs", ctypes.c_uint32)]

def main():
    if len(sys.argv) != 2 or sys.argv[1] not in INPUTS:
        raise SystemExit(f"usage: {sys.argv[0]} {{{','.join(INPUTS)}}}")
    value = INPUTS[sys.argv[1]]
    checksum = 0x50 ^ 0x84 ^ 0x03 ^ 0xF4 ^ value
    data = (ctypes.c_ubyte * 7)(0x50, 0x84, 0x03, 0xF4, 0x00, value, checksum)
    msg = I2CMsg(I2C_ADDR, 0, len(data), ctypes.cast(data, ctypes.c_void_p))
    request = I2CRdwr(ctypes.pointer(msg), 1)
    fd = os.open(I2C_BUS, os.O_RDWR)
    try:
        fcntl.ioctl(fd, I2C_RDWR, request)
    finally:
        os.close(fd)
    print(f"sent LG vendor input command {sys.argv[1]} (0x{value:02x})")

if __name__ == "__main__":
    main()
