#!/usr/bin/env bash
# ~/.local/bin/herdr-dcup
dir="${HERDR_ACTIVE_PANE_CWD:-$PWD}"

pause() { echo; read -rsn1 -p "Press any key to continue..."; }

has_config() { [[ -f "$1/.devcontainer/devcontainer.json" || -f "$1/.devcontainer.json" ]]; }

common=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
root=${common:+$(dirname "$common")}
if [[ -z "$root" ]]; then
  d=$(cd "$dir" && pwd -P)
  while [[ -n $d ]]; do
    if has_config "$d"; then
      root=$d
      break
    fi
    [[ $d == / ]] && break
    d=$(dirname "$d")
  done
fi
if [[ -z "$root" ]]; then
  echo "devcontainer is not found: $dir"; pause; exit 1
fi

config=$root/.devcontainer/devcontainer.json
[[ -f "$config" ]] || config=$root/.devcontainer.json
if [[ ! -f "$config" ]]; then
  echo "devcontainer is not found: $root"; pause; exit 1
fi

docker=$(command -v docker-safe || command -v docker)

images="${TMPDIR:-/tmp}/herdr-clipboard-images-$(id -u)"
mkdir -p -m 700 "$images"

extra=(
  --dotfiles-repository https://github.com/chiwanpark/dotfiles.git
  --dotfiles-target-path '~/.dotfiles'
  --docker-path "$docker"
  --remote-env TZ=Asia/Seoul
  --mount "type=bind,source=$HOME/.config/herdr,target=/run/herdr"
  --mount "type=bind,source=$(command -v herdr),target=/usr/local/bin/herdr"
  --mount "type=bind,source=$images,target=$images"
)

features=()

add_mount() {
  local source=$1 target=$2
  if grep -Eq "target(=|\"[[:space:]]*:[[:space:]]*\")${target//./\\.}[,\"]" "$config"; then
    return
  fi
  [[ -e "$source" ]] || mkdir -p -m 700 "$source"
  extra+=(--mount "type=bind,source=$source,target=$target")
}

container_user=$(sed -nE 's/.*"remoteUser"[[:space:]]*:[[:space:]]*"([^"$]+)".*/\1/p' "$config" | head -n 1)
container_user=${container_user:-$(id -un)}
if [[ $container_user == root ]]; then
  container_home=/root
else
  container_home=/home/$container_user
fi

local_conf=${XDG_CONFIG_HOME:-$HOME/.config}/herdr-dcup.local
[[ -f "$local_conf" ]] && source "$local_conf"

if grep -q docker-in-docker "$config" || [[ ${features[*]} == *docker-in-docker* ]]; then
  tmp_volume=herdr-tmp-$(printf '%s' "$root" | sha256sum | cut -d' ' -f1)
  if ! "$docker" volume inspect "$tmp_volume" >/dev/null 2>&1; then
    "$docker" volume create --driver local --opt type=tmpfs --opt device=tmpfs --opt o=mode=1777 "$tmp_volume" >/dev/null
  fi
  extra+=(--mount "type=volume,source=$tmp_volume,target=/tmp")
fi

if (( ${#features[@]} )); then
  extra+=(--additional-features "{$(IFS=,; echo "${features[*]}")}")
fi

devcontainer up --workspace-folder "$root" "${extra[@]}" "$@"
status=$?
[[ $status -eq 0 ]] && echo "devcontainer is up." || echo "fail to launch devcontainer: exitcode $status"
pause
exit $status
