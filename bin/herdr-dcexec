#!/usr/bin/env bash
require=0
shell=0
while [[ $# -gt 0 ]]; do
  case $1 in
    --require) require=1; shift ;;
    --shell) shell=1; shift ;;
    *) break ;;
  esac
done
if (( !shell )) && [[ $# -eq 0 ]]; then
  echo "usage: herdr-dcexec [--require] command [args...]" >&2
  echo "       herdr-dcexec [--require] --shell [args...]" >&2
  exit 2
fi

pause() { echo; read -rsn1 -p "Press any key to continue..."; }

run_host() {
  if (( shell )); then
    local sh=${SHELL:-/bin/bash}
    if [[ ${sh##*/} == herdr-pane-shell ]]; then
      sh=/bin/bash
    fi
    exec "${sh##*/}" -i "$@"
  fi
  exec "$@"
}

common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
root=${common:+$(dirname "$common")}
if [[ -z "$root" || ! ( -f "$root/.devcontainer/devcontainer.json" || -f "$root/.devcontainer.json" ) ]]; then
  run_host "$@"
fi

docker=$(command -v docker-safe || command -v docker)
if [[ -z "$docker" || -z $("$docker" ps -q --filter "label=devcontainer.local_folder=$root") ]]; then
  if (( require )); then
    echo "devcontainer is not running: $root"; pause; exit 1
  fi
  run_host "$@"
fi

name=$(basename "$root")
if [[ $name == workspaces ]]; then
  target=/workspaces
else
  target="/workspaces/$name"
fi
cwd=$(pwd -P)
if [[ $cwd == "$root"/* ]]; then
  target+=${cwd#"$root"}
fi

remote_env=(
  --remote-env TZ=Asia/Seoul
  --remote-env HERDR_ENV=1
  --remote-env "HERDR_PANE_ID=${HERDR_PANE_ID:-}"
  --remote-env HERDR_BIN_PATH=/usr/local/bin/herdr
  --remote-env HERDR_SOCKET_PATH=/run/herdr/herdr.sock
)
if [[ -n ${HERDR_AGENT:-} ]]; then
  remote_env+=(--remote-env "HERDR_AGENT=$HERDR_AGENT")
fi

if (( shell )); then
  set -- sh -c 'u=$(id -un); s=$(getent passwd "$u" 2>/dev/null || grep "^$u:" /etc/passwd); s=${s##*:}; [ -x "$s" ] || s=${SHELL:-/bin/bash}; [ -x "$s" ] || s=/bin/sh; exec "$s" -i "$@"' _ "$@"
fi

exec devcontainer exec --docker-path "$docker" --workspace-folder "$root" "${remote_env[@]}" \
  bash -c 'cd "$1" 2>/dev/null; shift; exec "$@"' _ "$target" "$@"
